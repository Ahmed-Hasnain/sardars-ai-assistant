SARDARS_APP_NAME="Sardars AI Assistant"
SARDARS_ENVIRONMENT=development
SARDARS_DB_USER=sardars
SARDARS_DB_NAME=sardars
SARDARS_DB_PASSWORD=replace-with-random-value
SARDARS_DB_HOST=127.0.0.1
SARDARS_DB_PORT=5433
SARDARS_OLLAMA_BASE_URL=http://127.0.0.1:11434
SARDARS_OLLAMA_MODEL=qwen3:0.6b
SARDARS_OLLAMA_TIMEOUT_SECONDS=120
SARDARS_OLLAMA_KEEP_ALIVE=0
SARDARS_QDRANT_BASE_URL=http://127.0.0.1:6333
# Optional narrow Bongio-definition retrieval hint; blank disables it.
SARDARS_BRAND_DEFINITION_PROFILE_URL=https://sardarandco.com/pages/about-us
SARDARS_IMPORT_TIMEOUT_SECONDS=300
SARDARS_EMBEDDING_BATCH_SIZE=2
SARDARS_INGESTION_STORAGE_DIR=data/uploads
# JSON array of exact HTTPS hosts permitted for authenticated single-page imports.
SARDARS_INGESTION_URL_HOSTS=["sardarandco.com"]
